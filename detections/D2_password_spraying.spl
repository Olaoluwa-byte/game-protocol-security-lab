# D2 — Password spraying
# Logic: At least five distinct accounts fail from one source IP in a 5-minute bin.
# Threshold: 5 distinct accounts / 5m / src_ip (lab-tuned, per src_ip)
# Confidence: High
# ATT&CK: T1110.003   CWE: none
# Validated: 2026-10-14 — positive fired (6 accounts), negative silent, isolated case windows
index=c09 event=auth outcome=failure
| bin _time span=5m
| stats dc(user_ref) as accounts by _time, src_ip
| where accounts >= 5
