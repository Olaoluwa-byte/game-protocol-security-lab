# D4 — Game join without observed matching handoff
# Logic: Game join has no matching source-endpoint handoff in the prior five minutes.
# Threshold: 1 unmatched join / prior 5m / source endpoint (lab-tuned, per src_ip)
# Confidence: Medium
# ATT&CK: none   CWE: CWE-306
# Validated: 2026-10-14 — positive fired (1 unmatched join), negative silent, isolated case windows
index=c09 (event=join_handoff OR event=player_join)
| sort 0 _time
| eval ep=src_ip."|".src_port
| streamstats time_window=5m current=t latest(eval(if(event=="join_handoff",_time,null()))) as last_handoff by ep
| where event=="player_join" AND (isnull(last_handoff) OR last_handoff < (_time - 300))
| table _time, src_ip, src_port
